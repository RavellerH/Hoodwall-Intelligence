# Copy this file to .env and fill in your own values. Never commit .env.

# Google Sheets/Drive
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=service-account.json

# Telegram (MTProto userbot - for reading the source channel)
TG_API_ID=
TG_API_HASH=
TG_PHONE=+10000000000
TG_SOURCE=@channelname

# Telegram (alert bot - for sending digests)
TELEGRAM_BOT_TOKEN=
YOUR_TELEGRAM_USER_ID=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Blockscout
BLOCKSCOUT_BASE=https://robinhoodchain.blockscout.com/api/v2

# hood.vantis.sh
HOOD_BASE_URL=https://hood.vantis.sh

# Screen OCR (optional fallback ingestion source)
OCR_ENABLED=false
OCR_CAPTURE_INTERVAL=300
OCR_MONITOR_LEFT=100
OCR_MONITOR_TOP=100
OCR_MONITOR_WIDTH=800
OCR_MONITOR_HEIGHT=600
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# Smart Score tier thresholds
ELITE_SCORE=80
WATCH_SCORE=65
CANDIDATE_SCORE=45
