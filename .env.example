# Local debugging only. In the cloud these come from GitHub Actions
# secrets and variables - there is no .env file in CI.

# Chain
BLOCKSCOUT_BASE=https://robinhoodchain.blockscout.com/api/v2
CHAIN_EXPLORER_URL=https://robinhoodchain.blockscout.com
NATIVE_SYMBOL=ETH

# hood.vantis.sh
HOOD_BASE_URL=https://hood.vantis.sh
HOOD_FORCE_BROWSER=false

# bizyugoscan.com
BIZYUGOSCAN_BASE_URL=https://bizyugoscan.com
BIZYUGOSCAN_FORCE_BROWSER=false

# Telegram ingestion (mint the session with scripts/mint_telegram_session.py)
TG_API_ID=
TG_API_HASH=
TG_SESSION_STRING=
TG_SOURCE=@channelname

# Telegram digest
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Score tiers
ELITE_SCORE=80
WATCH_SCORE=65
CANDIDATE_SCORE=45

# Per-run budgets
MAX_ENRICH_PER_RUN=60
MAX_EVENTS_PER_WALLET=100
MAX_DISCOVERY_BLOCKS=20

# Flow tracing (scripts/trace_flow.py)
MAX_FLOW_DEPTH=2
MAX_FLOW_ADDRESSES=120
MAX_FLOW_PAGES=3

# Publish raw Telegram message text to the public site (default false)
PUBLISH_RAW_TEXT=false
